{
  "name": "elevator-simulator-interview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/main.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
